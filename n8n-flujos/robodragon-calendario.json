{
  "name": "RoboDragón - Crear evento en Google Calendar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "robodragon-calendario",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook de RoboDragón",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "robodragon-calendario"
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "start": "={{ ($json.body.dentro_de_minutos ? $now.setZone('Atlantic/Canary').plus({ minutes: Number($json.body.dentro_de_minutos) }) : DateTime.fromISO($json.body.inicio, { zone: 'Atlantic/Canary' })).toISO() }}",
        "end": "={{ ($json.body.dentro_de_minutos ? $now.setZone('Atlantic/Canary').plus({ minutes: Number($json.body.dentro_de_minutos) }) : DateTime.fromISO($json.body.inicio, { zone: 'Atlantic/Canary' })).plus({ minutes: Number($json.body.duracion_minutos) || 30 }).toISO() }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "={{ $json.body.titulo }}",
          "description": "Apuntado por RoboDragón 🐉"
        }
      },
      "name": "Crear evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Evento creado en Google Calendar: \"{{ $json.summary }}\" el {{ DateTime.fromISO($json.start.dateTime).setZone('Atlantic/Canary').toFormat(\"dd/MM 'a las' HH:mm\") }} (hora de Canarias).",
        "options": {}
      },
      "name": "Responder a RoboDragón",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
    "Webhook de RoboDragón": {
      "main": [
        [
          {
            "node": "Crear evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear evento": {
      "main": [
        [
          {
            "node": "Responder a RoboDragón",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Atlantic/Canary"
  }
}