      "typeVersion": 1.1,
      "position": [
        880,
        160
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "task": "={{ $('Elegir la lista').first().json.listaId }}",
        "returnAll": true,
        "additionalFields": {}
      },
      "name": "Leer la lista",
      "type": "n8n-nodes-base.googleTasks",
      "typeVersion": 1,
      "position": [
        880,
        -40
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Decide qué hacer con la lista elegida: añadir (sin duplicar), ver o quitar (solo si encaja uno)\nconst pedido = $('Webhook de RoboDragón').first().json.body;\nconst nombre = $('Elegir la lista').first().json.listaNombre;\nconst normalizar = s => (s || '').toLowerCase().normalize('NFD').replace(/\\p{M}/gu, '').trim();\nconst accion = normalizar(pedido.accion);\nconst lista = $input.all().map(i => i.json).filter(t => t.id && t.title && t.status !== 'completed');\nconst productos = (pedido.productos || '').split(/,|\\sy\\s/).map(p => p.trim()).filter(Boolean);\n\nif (accion.startsWith('anad') || accion.startsWith('agreg') || accion.startsWith('pon')) {\n  const nuevos = productos.filter(p => !lista.some(t => normalizar(t.title) === normalizar(p)));\n  const repetidos = productos.filter(p => !nuevos.includes(p));\n  if (nuevos.length === 0) {\n    return [{ json: { accion: 'nada', mensaje: productos.length ? 'Ya estaba en la lista \"' + nombre + '\": ' + repetidos.join(', ') + '.' : 'No me han dicho qué añadir.' } }];\n  }\n  const resumen = 'Añadido a la lista \"' + nombre + '\": ' + nuevos.join(', ') + '.' + (repetidos.length ? ' Ya estaba: ' + repetidos.join(', ') + '.' : '');\n  return nuevos.map(p => ({ json: { accion: 'crear', titulo: p.charAt(0).toUpperCase() + p.slice(1), resumen } }));\n}\n\nif (accion.startsWith('quit') || accion.startsWith('borr') || accion.startsWith('tach')) {\n  const buscado = normalizar(productos[0]);\n  const encajan = buscado ? lista.filter(t => normalizar(t.title).includes(buscado)) : [];\n  if (encajan.length === 1) {\n    return [{ json: { accion: 'borrar', id: encajan[0].id, resumen: 'Quitado de la lista \"' + nombre + '\": ' + encajan[0].title + '.' } }];\n  }\n  const mensaje = encajan.length === 0\n    ? 'No he quitado nada: no está \"' + (productos[0] || '') + '\" en la lista \"' + nombre + '\".'\n    : 'No he quitado nada: encajan varios, ¿cuál? ' + encajan.map(t => t.title).join(', ') + '.';\n  return [{ json: { accion: 'nada', mensaje } }];\n}\n\n// Ver la lista\nreturn [{ json: { accion: 'nada', mensaje: lista.length ? 'En la lista \"' + nombre + '\" hay: ' + lista.map(t => t.title).join(', ') + '.' : 'La lista \"' + nombre + '\" está vacía.' } }];"
      },
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
