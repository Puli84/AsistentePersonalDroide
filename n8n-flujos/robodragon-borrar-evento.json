{
  "name": "RoboDragón - Borrar evento de Google Calendar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "robodragon-borrar-evento",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook de RoboDragón",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "robodragon-borrar-evento"
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "returnAll": true,
        "timeMin": "={{ ($json.body.fecha ? DateTime.fromISO($json.body.fecha, { zone: 'Atlantic/Canary' }) : $now.setZone('Atlantic/Canary').plus({ days: Number($json.body.dias_desde_hoy) || 0 })).startOf('day').toISO() }}",
        "timeMax": "={{ ($json.body.fecha ? DateTime.fromISO($json.body.fecha, { zone: 'Atlantic/Canary' }) : $now.setZone('Atlantic/Canary').plus({ days: Number($json.body.dias_desde_hoy) || 0 })).startOf('day').plus({ days: 1 }).toISO() }}",
        "options": {
          "orderBy": "startTime"
        }
      },
      "name": "Buscar eventos del día",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [240, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Busca el evento a borrar. Solo se borra si encaja EXACTAMENTE uno; si no, se explica qué hay.\nconst pedido = $('Webhook de RoboDragón').first().json.body;\nconst normalizar = s => (s || '').toLowerCase().normalize('NFD').replace(/\\p{M}/gu, '').trim();\nconst buscado = normalizar(pedido.titulo);\nconst describir = e => (e.start.dateTime\n  ? DateTime.fromISO(e.start.dateTime).setZone('Atlantic/Canary').setLocale('es').toFormat(\"cccc d 'a las' HH:mm\")\n  : DateTime.fromISO(e.start.date).setLocale('es').toFormat('cccc d') + ', todo el día') + ': ' + (e.summary || '(sin título)');\n\nconst eventos = $input.all().map(i => i.json).filter(e => e.start && e.id);\nif (!buscado) {\n  return [{ json: { accion: 'nada', mensaje: 'No he borrado nada: falta decir qué evento.' } }];\n}\nlet encajan = eventos.filter(e => normalizar(e.summary).includes(buscado));\nif (pedido.hora) {\n  encajan = encajan.filter(e => e.start.dateTime\n    && DateTime.fromISO(e.start.dateTime).setZone('Atlantic/Canary').toFormat('HH:mm') === pedido.hora);\n}\nif (encajan.length === 1) {\n  return [{ json: { accion: 'borrar', id: encajan[0].id, descripcion: describir(encajan[0]) } }];\n}\nif (encajan.length === 0) {\n  const hay = eventos.length ? ' Ese día hay: ' + eventos.map(describir).join('; ') + '.' : ' Ese día no hay ningún evento.';\n  return [{ json: { accion: 'nada', mensaje: 'No he borrado nada: no encuentro ningún evento así.' + hay } }];\n}\nreturn [{ json: { accion: 'nada', mensaje: 'No he borrado nada: encajan varios, hay que decir cuál (por ejemplo por la hora): ' + encajan.map(describir).join('; ') + '.' } }];"
      },
      "name": "Elegir el evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hay-uno",
              "leftValue": "={{ $json.accion }}",
              "rightValue": "borrar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Hay uno?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "operation": "delete",
        "calendar": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "eventId": "={{ $json.id }}",
        "options": {}
      },
      "name": "Borrar evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [960, -100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Borrado del calendario: {{ $('Elegir el evento').first().json.descripcion }}.",
        "options": {}
      },
      "name": "Responder: borrado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.mensaje }}",
        "options": {}
      },
      "name": "Responder: no borrado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 100]
    }
  ],
  "connections": {
    "Webhook de RoboDragón": {
      "main": [[{ "node": "Buscar eventos del día", "type": "main", "index": 0 }]]
    },
    "Buscar eventos del día": {
      "main": [[{ "node": "Elegir el evento", "type": "main", "index": 0 }]]
    },
    "Elegir el evento": {
      "main": [[{ "node": "¿Hay uno?", "type": "main", "index": 0 }]]
    },
    "¿Hay uno?": {
      "main": [
        [{ "node": "Borrar evento", "type": "main", "index": 0 }],
        [{ "node": "Responder: no borrado", "type": "main", "index": 0 }]
      ]
    },
    "Borrar evento": {
      "main": [[{ "node": "Responder: borrado", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "timezone": "Atlantic/Canary"
  }
}
