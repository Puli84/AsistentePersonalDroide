      "name": "Ver tus listas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Busca la lista de Google Tasks por su nombre (sin mayúsculas ni tildes). Por defecto, la de la compra.\nconst pedido = $('Webhook de RoboDragón').first().json.body;\nconst normalizar = s => (s || '').toLowerCase().normalize('NFD').replace(/\\p{M}/gu, '').trim();\nconst listas = $input.first().json.items || [];\nconst buscada = normalizar(pedido.lista || 'compra');\nconst lista = listas.find(l => normalizar(l.title) === buscada)\n  || listas.find(l => normalizar(l.title).includes(buscada) || buscada.includes(normalizar(l.title)));\nif (!lista) {\n  return [{ json: { ok: false, mensaje: 'No tengo ninguna lista que se llame \"' + (pedido.lista || '') + '\". Las listas que hay son: ' + (listas.map(l => l.title).join(', ') || 'ninguna') + '. Si la quieres, créala en la app de Google Tasks.' } }];\n}\nreturn [{ json: { ok: true, listaId: lista.id, listaNombre: lista.title } }];"
      },
      "name": "Elegir la lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
